# Datos: se versionan en este repo para que al clonar esté todo disponible
# Nota: revisa las licencias de Kaggle antes de redistribuir en un repo público.

# Credenciales de Kaggle — NUNCA versionar
kaggle.json
.kaggle/

# Entornos virtuales
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# Notebooks: salidas pesadas (opcional, se conservan .ipynb)
# *.ipynb

# PPTs: los .md son la fuente; el HTML se versiona para verlo directo al clonar.
# El PDF/PPTX se generan bajo demanda con Marp y no se versionan.
ppts/**/*.pdf
ppts/**/*.pptx

# Sistema operativo
.DS_Store
Thumbs.db

# Editores
.vscode/
.idea/

# Soluciones del instructor — NUNCA versionar (el repo lo clonan los estudiantes)
soluciones-instructor/

# Material con copyright y accesos directos locales
literatura/
*.lnk

# Material del instructor (planeación, scripts, soluciones) — NO se publica a estudiantes
material-instructor/

# Tema 4 (NLP, FDS 4: 9-10 oct): se publica cuando se dicte. Para liberarlo,
# borra estas 3 líneas y haz `git add data/04-nlp notebooks/04-nlp ppts/04-nlp`.
data/04-nlp/
notebooks/04-nlp/
ppts/04-nlp/
