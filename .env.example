# Copia este archivo como .env y completa UNA de las dos opciones. NUNCA subas .env a Git.

# Evita errores de codificación al imprimir en la consola de Windows
PYTHONUTF8=1

# --- Opción A: perfil de Databricks (recomendada si instalaste el CLI de Databricks) ---
# El nombre es el de la sección [..] de tu archivo ~/.databrickscfg
# En el código: mlflow.set_tracking_uri(f"databricks://{PROFILE}")
#               mlflow.set_registry_uri(f"databricks-uc://{PROFILE}")
PROFILE=nombre-de-tu-perfil

# --- Opción B: token personal (más simple, no requiere el CLI) ---
# DATABRICKS_HOST=https://TU-WORKSPACE.cloud.databricks.com
# DATABRICKS_TOKEN=pega-aqui-tu-token-personal
# MLFLOW_TRACKING_URI=databricks
# MLFLOW_REGISTRY_URI=databricks-uc

# --- Opcionales ---
# UC_CATALOG=workspace      # catálogo de Unity Catalog donde se registran los modelos
# UC_SCHEMA=default         # esquema de Unity Catalog
# EXPERIMENT_DIR=/Users/tu-correo/tu-carpeta   # carpeta del workspace (debe existir) donde quedan los experimentos
# MLFLOW_FORCE_LOCAL=1      # fuerza MLflow local (sqlite) aunque haya conexión, p. ej. si se agotó la cuota
